# ─── Supabase ──────────────────────────────────────────────────────
# Find both in the Supabase dashboard: Project Settings → API Keys.
# The publishable key is safe in the browser; Row Level Security protects your data.
# An older project can use its legacy "anon" key here instead.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Site ──────────────────────────────────────────────────────────
# Where Supabase sends people back after Google/Apple sign-in, email
# confirmation and password reset. Use https://your-domain.com in production.
# Add <this URL>/auth/callback to Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database (Postgres) ───────────────────────────────────────────
# Supabase dashboard: Connect → Connection string. Replace [YOUR-PASSWORD]
# with the database password (Project Settings → Database to reset it).
# Pooled connection (transaction mode, port 6543): used by the app at runtime.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres
# Session pooler (port 5432): for migrations and admin tools only.
# The true direct host, db.your-project-ref.supabase.co:5432, needs IPv6 or the IPv4 add-on.
DIRECT_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# ─── Server-only Supabase key ──────────────────────────────────────
# Project Settings → API Keys → secret key. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_ and never use it in client code.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx


# ─── Stripe (payments) ─────────────────────────────────────────────
# Stripe dashboard → Developers → API keys. Use the test keys until launch.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Server-only. Never prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_...
# Locally: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# Production: Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Cloudflare R2 (course videos) ─────────────────────────────────
# Server-only. Never prefix with NEXT_PUBLIC_.
# Account ID: R2 overview page → Account Details.
# Keys: R2 → Manage API Tokens → Create API token, "Object Read only",
# limited to the course bucket. Use a separate Read & Write token for uploads.
R2_ACCOUNT_ID=your-account-id
# The S3 API address from the bucket's Settings tab, without the bucket name.
# Buckets in a jurisdiction use an address like https://<account-id>.us.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=your-bucket-name
